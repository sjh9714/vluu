# 이 파일을 `.env.local`로 복사해 쓴다. 다만 셋 다 선택이다 — 하나도 없어도 돌아간다.

# 사이트맵과 OG 메타데이터의 절대 주소.
# 없으면 Vercel이 빌드 때 넣어주는 VERCEL_PROJECT_PRODUCTION_URL을 보고,
# 그것도 없으면 http://localhost:4321로 떨어진다.
#
# 그래서 Vercel 기본 도메인(*.vercel.app)만 쓸 거면 이 값을 넣을 필요가 없다.
# 커스텀 도메인을 붙일 때만 넣는다.
# NEXT_PUBLIC_SITE_URL=https://vluu.example
